<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>traversability_layer_plugin</name>
  <version>0.1.0</version>
  <description>Run-time plugin for traversability based navigation</description>
  <maintainer email="baba066h.s@gmail.com">Baba HADJ SAID</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
 
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <export>
    <nav2_costmap_2d plugin="${prefix}/traversability_layer.xml" />
    <build_type>ament_cmake</build_type>
  </export>
</package>
